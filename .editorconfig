# ──────────────────────────────────────────────────────────────────────────────
# Binti — EditorConfig
#
# Defines consistent coding style across editors and IDEs.
# See: https://editorconfig.org/
# ──────────────────────────────────────────────────────────────────────────────

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.{kt,kts}]
# Kotlin-specific: ktlint-compatible defaults
ij_kotlin_imports_layout = *
ij_kotlin_name_count_to_use_star_import = 5
ij_kotlin_name_count_to_use_star_import_for_members = 5

[*.{xml,json,yaml,yml,toml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
