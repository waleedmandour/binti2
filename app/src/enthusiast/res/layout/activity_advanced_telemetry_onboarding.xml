<?xml version="1.0" encoding="utf-8"?>
<!--
  Tier 2 — Advanced Telemetry Onboarding layout (enthusiast flavor only).
  Verbosity is intentional: the user MUST read and acknowledge the warning
  before the consent toggle flips to GRANTED.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/advanced_telemetry_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvTelemetryWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:background="#2AF44336"
            android:padding="16dp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/tvConsentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="13sp"
            android:textStyle="italic" />

        <CheckBox
            android:id="@+id/cbAcknowledge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/advanced_telemetry_acknowledge" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:enabled="false"
            android:text="@string/advanced_telemetry_enable" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:text="@string/advanced_telemetry_attribution" />

    </LinearLayout>
</ScrollView>
