<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default configuration: No cleartext traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Vosk models — official hosting at alphacephei.com -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">alphacephei.com</domain>
    </domain-config>

    <!-- Sherpa-ONNX TTS models — hosted on GitHub Releases -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">objects.githubusercontent.com</domain>
    </domain-config>

    <!-- GitHub Releases & Pages domains for model/station data downloads -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">raw.githubusercontent.com</domain>
        <domain includeSubdomains="true">objects.githubusercontent.com</domain>
        <domain includeSubdomains="true">github.io</domain>
    </domain-config>

    <!-- Huawei HMS services -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">huawei.com</domain>
        <domain includeSubdomains="true">hicloud.com</domain>
    </domain-config>
</network-security-config>
