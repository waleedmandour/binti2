<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility Service configuration for Binti.

  CRITICAL: This config is the single source of truth for the service.
  onServiceConnected() no longer mutates serviceInfo at all (v3.0.2) —
  everything is declared here. Mutating AccessibilityServiceInfo after the
  framework applied the XML config was one of the crash-on-enable triggers
  on DiLink 3 (Android 10) head units.

  Design decisions:
  - packageNames: intentionally OMITTED — v3.0.2 removed the programmatic
    guessed-package filter because it silently dropped events from real
    DiLink/system packages that were not on the list. With no filter set
    (null), the framework delivers events from ALL packages; relevance is
    decided per-event in onAccessibilityEvent() and the expensive snapshot
    scraping stays gated by VEHICLE_DATA_PACKAGES + a 2s throttle.
  - accessibilityEventTypes: includes typeViewTextChanged (for nav search
    field detection) and typeViewScrolled (for recent-calls list).
  - accessibilityFlags: flagIncludeNotImportantViews + flagReportViewIds +
    flagRetrieveInteractiveWindows. NOTE: flagRequestFilterKeyEvents was
    REMOVED — it requires canRequestFilterKeyEvents and caused crashes on
    some Android 10 OEM head units (including DiLink 3). Media-key
    interception is handled via AudioManager.dispatchMediaKeyEvent()
    instead, which doesn't need this flag.
  - canRetrieveWindowContent="true": required for findAccessibilityNodeInfosByViewId.
  - canPerformGestures="true": required for performGesture()/performSwipe().
  - notificationTimeout="0": deliver every event immediately, no coalescing.
  - settingsActivity: points to MainActivity so the Settings → Accessibility
    screen shows a "Settings" link next to the service toggle.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewClicked|typeViewFocused|typeViewTextChanged|typeViewScrolled"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagIncludeNotImportantViews|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="true"
    android:notificationTimeout="0"
    android:settingsActivity="com.binti.dilink.MainActivity" />
