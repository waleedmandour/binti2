<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ──────────────────────────────────────────────────────────────────────
         Dark mode colors (Phase 4)
         ──────────────────────────────────────────────────────────────────────
         Used when the system is in dark mode (Android 10+ UI_MODE_NIGHT_YES)
         or when the user selects "Dark" in app settings (future).

         The dark palette uses Binti Dark Blue (#001C35) as the background,
         with the same brand blue (#0082C8) and gold (#D4AF37) accents.
         Surface colors are slightly lighter than the background to create
         visual hierarchy without straining the eyes at night.
         ────────────────────────────────────────────────────────────────────── -->

    <!-- Brand colors (same as light — brand identity is consistent) -->
    <color name="binti_dark_blue">#001C35</color>
    <color name="binti_light_blue">#0082C8</color>
    <color name="binti_gold">#D4AF37</color>

    <!-- Dark theme overrides -->
    <color name="primary">#0082C8</color>
    <color name="primary_dark">#000F1F</color>
    <color name="primary_light">#0A2A4A</color>
    <color name="accent">#D4AF37</color>

    <color name="background">#001C35</color>
    <color name="card_background">#0A2A4A</color>
    <color name="surface">#0D3556</color>
    <color name="white">#FFFFFF</color>

    <color name="text_primary">#E0E0E0</color>
    <color name="text_secondary">#B0BEC5</color>
    <color name="text_hint">#78909C</color>

    <color name="divider">#37474F</color>

    <color name="success">#66BB6A</color>
    <color name="error">#EF5350</color>
    <color name="warning">#FFB74D</color>

    <color name="overlay_background">#E6001C35</color>
    <color name="huawei_red">#CF0A2C</color>

    <color name="permission_granted">#E666BB6A</color>
    <color name="permission_denied">#E6EF5350</color>

    <color name="ic_launcher_background">#001C35</color>
</resources>
